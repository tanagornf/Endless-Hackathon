{
  "description": "NLess hackathon team board: wake this lane's Codex session when a board post is addressed to it. Lane = .lane in the worktree root; board = tools/team-board.ps1. Open Codex at the lane worktree root.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/session-start.ps1",
            "timeout": 60,
            "statusMessage": "Reading team board"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/user-prompt.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/user-prompt.ps1",
            "timeout": 60,
            "statusMessage": "Checking team board"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/stop.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/stop.ps1",
            "timeout": 600,
            "statusMessage": "Waiting up to 9 min for team board posts (interrupt to type)"
          }
        ]
      }
    ]
  }
}
