# .env.example — Endless hackathon app (copy to repo root at 10:00; C1 owns it)
#
# PLACEHOLDERS ONLY. Never put a real key, token, password or customer value in this file, in git,
# in a board post or in a test fixture.
#
# How values reach a worktree:
#   1. Each laptop keeps ONE secrets file OUTSIDE every repo: ../nless.secrets.env (KEY=value lines,
#      next to the worktrees). Only real test keys go there. OPENAI_API_KEY in it is that PERSON's own key
#      from the OpenAI project `app-dev` (hard limit US$30); the same key serves all 4 sessions of that person.
#   2. `npm run lane:init` (reads .lane: A0..A3 B0..B3 C0..C3) writes .env.local = this file + lane values
#      (ports, DB name, APP_BASE_URL, E2E_BASE_URL) + ../nless.secrets.env. .env.local is git-ignored.
#   3. server/src/core/config.ts loads .env.local, then lets the process environment override it, and
#      validates everything with zod. A missing provider key never crashes boot: that provider stays in
#      sandbox mode and its status says so. In production (NODE_ENV=production) a few values are REQUIRED
#      (SESSION_SECRET, TOKEN_ENCRYPTION_KEY, DATABASE_URL, APP_BASE_URL) and boot fails by name if missing.
#   4. Production values live only in Render environment variables (docs/day/deployment.md has the table).
#      Production uses its own OpenAI key from the project `app-prod` (hard limit US$60), never a person's key.
#
# `[Fxx slug · lane]` = the feature that reads the variable and the lane that owns it (PLAN.md, 20 Nov lanes).
# `core` = server/src/core (C1). `core → Fxx` = core reads it on behalf of that feature.
# VITE_* variables are compiled into the browser bundle: never put a secret in a VITE_* variable.
# Scope is 31 features (29 feature folders + core + core/jobs): only variables that a build spec needs are listed.

# ─────────────────────────────── runtime & lane (core) ───────────────────────────────
# [core] development | test | production. production = Render: trust proxy, Secure cookies, required secrets,
# dev login needs DEV_LOGIN_TOKEN (see below).
NODE_ENV=development
# [core] A0 B0 C0 (orchestrators) | A1..A3 B1..B3 C1..C3 (workers) — written by `npm run lane:init` from .lane
LANE=C0
# [core] API port = 3000 + lane number (orchestrators 0, C1 1, C2 2, C3 3, B1 4, B2 5, B3 6, A1 7, A2 8, A3 9)
API_PORT=3000
# [core] Production/Render listen port. When set it WINS over API_PORT (the server binds 0.0.0.0:$PORT). Empty in dev.
PORT=
# [core] Vite dev port = 5170 + lane number. Vite proxies /api, /webhooks, /ws to API_PORT.
WEB_PORT=5170
# [core] Browser origin allowed for session cookies + CSRF Origin check (dev: http://localhost:<WEB_PORT>)
WEB_ORIGIN=http://localhost:5170
# [core] Public base URL of THIS deployment, no trailing slash (dev: http://localhost:<WEB_PORT>; production: the Render URL).
# Used for links in email/OAuth redirects/webhook URLs shown in the UI, and accepted as a CSRF origin. REQUIRED in production.
APP_BASE_URL=http://localhost:5170
# [core, F17 line · C2, F18 meta · C2, F21 comments · C2, F14 payments · A2, F16 calendar · A3, F06 knowledge-import · B3]
# Public HTTPS base of the tunnel (ngrok / Cloudflare Tunnel) pointing at THIS worktree's API_PORT.
# Webhooks are ${PUBLIC_BASE_URL}/webhooks/<provider>/...; OAuth redirects use it too. Empty = no inbound webhooks.
# F30 voice needs HTTPS (or localhost) for the microphone.
PUBLIC_BASE_URL=
# [core, F36 release · C1] build identity shown at /build-info (CI sets it; local = git rev-parse)
BUILD_SHA=
# [core] pino level: fatal error warn info debug
LOG_LEVEL=info

# ─────────────────────────────── database (core) ───────────────────────────────
# [core lane:init] DEV only. Server part of the person's Neon project, DIRECT (non-pooled, no "-pooler" in the host) endpoint,
# ending with ?sslmode=require (lane:init appends the same query after the database name). No database name here.
# Keep the real value in ../nless.secrets.env. lane:init builds DATABASE_URL=${PG_SERVER_URL}/nless_hack_<lane> and
# TEST_DATABASE_URL=..._test from it; `npm run db:create` creates both. Fallback = local Postgres 16 + pgvector in WSL
# (postgres://postgres:<pass>@127.0.0.1:5432, same variable, no sslmode).
PG_SERVER_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_DIRECT_HOST/neondb?sslmode=require
# [core] One DB per session: nless_hack_<lane lowercase> (C0 → nless_hack_c0), allow-list ^nless_hack_[a-c][0-3](_test)?$ for create/reset.
# Production: set by Render from the Render Postgres connection string (any database name; never run db:create/db:reset there).
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_NEON_DIRECT_HOST/nless_hack_c0?sslmode=require
# [core] Test DB for `npm test` (reset by vitest globalSetup). Default = DATABASE_URL name + "_test".
TEST_DATABASE_URL=
# [core] kept for readability: dev databases are named with this prefix (the hard check is the allow-list regex in assertSafeDbName).
DB_NAME_PREFIX=nless_hack_
# [core] pool size per process (Neon free tier has a low connection limit: keep ≤ 5)
DB_POOL_MAX=5
# [core] ms; every statement
DB_STATEMENT_TIMEOUT_MS=10000

# ─────────────────────────────── sessions & auth (core, F02 auth · C3, F03 tenancy · C3) ───────────────────────────────
# [core] HMAC/pepper for session token hashing. ≥ 32 random chars, different per laptop. Generate locally.
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
# [core] session lifetime
SESSION_TTL_HOURS=12
# [core] 1 = set Secure on the cookie (HTTPS deploy). Local http dev = 0. Forced to 1 when NODE_ENV=production.
COOKIE_SECURE=0
# [core] DEV LOGIN (POST /api/dev/login + /dev-login page). Exists for local dev and for the FIRST production hours only.
# 1 = allow it to be mounted. F03 runs on it until F02 (real login) is merged.
DEV_LOGIN=1
# [core] kill switch. On production set DEV_LOGIN_ENABLED=false (Render env + redeploy) as soon as F02 is merged (C3) and real login works.
# false/0 = the dev routes are not mounted (404), whatever DEV_LOGIN says.
DEV_LOGIN_ENABLED=true
# [core] REQUIRED on production for dev login: a random string ≥ 24 chars set in Render env. Every /api/dev/* request must send it
# as header X-Dev-Login-Token (the /dev-login page asks for it). Missing/short on production = dev routes are NOT mounted.
# Empty in dev. Never commit a real value; Playwright uses E2E_DEV_LOGIN_TOKEN for it.
DEV_LOGIN_TOKEN=
# [core] 32 random bytes, base64 (generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"). AES-256-GCM key for
# provider tokens (LINE/Meta/Google) and payment settings stored in the DB via encryptSecret(). REQUIRED on production (Render env).
# Empty in dev = derived from SESSION_SECRET with a warning (lane:init writes a random one into .env.local).
TOKEN_ENCRYPTION_KEY=
# [core → web shell] feature ids hidden at first boot, comma separated (e.g. F13,F14). Initial value only: inserted into
# feature_flags if not already there; the /ops page (F35) or PUT /api/v1/ops/features/:id changes it later. Placeholder pages are
# hidden in production anyway. Empty = nothing hidden by env.
HIDDEN_FEATURES=
# [F02 auth · C3] password for the SPEC §5 seed users once real login exists. Set locally only, never commit.
SEED_USER_PASSWORD=
# [F02 auth · C3, F03 tenancy · C3] email transport. sandbox = rows in the local email outbox only (no mail is sent).
EMAIL_MODE=sandbox
# [F02 auth · C3] verify / reset token lifetime (minutes)
AUTH_TOKEN_TTL_MINUTES=30
# [F03 tenancy · C3] invitation lifetime (hours)
INVITATION_TTL_HOURS=72

# ─────────────────────────────── uploads (core storage) ───────────────────────────────
# [core, F05 knowledge · B1, F06 knowledge-import · B3, F09 inbox · A1, F12 message-templates · A1, F14 payments · A2]
# local disk, git-ignored. Dev: ./var/uploads · Production (Render disk): /var/data/uploads
UPLOAD_DIR=./var/uploads
# [core] max size per file
UPLOAD_MAX_MB=20

# ─────────────────────────────── jobs (F35 core/jobs · C1) ───────────────────────────────
# [F35 core/jobs · C1] 1 = run the job worker inside the API process (dev and production: one Node server does everything)
RUN_WORKER=1
# [F35 core/jobs · C1] 1 = run the in-process scheduler. It only works while holding a Postgres advisory lock, so a second
# instance can never double-run schedules. 0 = never schedule from this process.
RUN_SCHEDULER=1
# [F35 core/jobs · C1] old name of RUN_WORKER, still read when RUN_WORKER is empty
JOBS_WORKER=1
# [F35 core/jobs · C1] idle poll interval; enqueue wakes the worker immediately in-process
JOBS_POLL_MS=250
# [F35 core/jobs · C1] default max attempts before 'dead'
JOBS_MAX_ATTEMPTS=5
# [F35 core/jobs · C1] lease length; an expired lease is reclaimed after a crash
JOBS_LEASE_SECONDS=60

# ─────────────────────────────── AI: OpenAI API only (core model.*; docs/openai-api.md) ───────────────────────────────
# Every AI call goes through core model.* (Responses API, store:false, no temperature/top_p) and writes model_usage.
# Only core imports the `openai` SDK. No other AI provider. Features pick model:'chat'|'fast'|'strong', never an id.
# Defaults below come from docs/openai-api.md §1; if the §14 smoke test gets 403/404 for one, put the closest working
# model here and record it in SOURCE-BASELINE.md.
# [core] openai | fake. Empty OPENAI_API_KEY → fake. Tests and CI always use fake.
MODEL_MODE=openai
# [core] dev: the person's OWN key from the OpenAI project `app-dev` (hard limit US$30), only in ../nless.secrets.env, never here.
# production: the key of the project `app-prod` (hard limit US$60), only in Render env. Codex itself never uses an API key.
OPENAI_API_KEY=
# [core] optional base URL; empty = OpenAI default
OPENAI_BASE_URL=
# [core → F10 ai-agent · B2, F14 payments · A2 (slip vision), F26 insights · B3, F06 knowledge-import · B3] model:'chat'
# Team decision 20 Nov: gpt-6.2-sol for every text job (all three aliases). Lower one later via env only if needed.
OPENAI_CHAT_MODEL=gpt-6.2-sol
# [core → F10 · B2 (classifier, extraction), F07 · B1 (rerank), F13 · A2 / F15 · A3 (extraction), F26 · B3 (summary),
#  F09 · A1 (translate)] model:'fast' = lowest effort + strict json_schema ('none' is sent as 'low' for gpt-6.2-*)
OPENAI_CHAT_MODEL_FAST=gpt-6.2-sol
# [core → F10 ai-agent · B2] model:'strong': at most one retry per turn (hard tool loop / failed claim check).
# Never effort 'none' (gpt-6.2-sol answers 400); core sends 'low' instead.
OPENAI_CHAT_MODEL_STRONG=gpt-6.2-sol
# [core → F05 knowledge · B1, F07 knowledge-search · B1, F08 catalog · B1, F06 knowledge-import · B3]
# one embedding model for documents AND queries (no input_type)
OPENAI_EMBED_MODEL=text-embedding-3-large
# [core] sent as `dimensions`; must match the pgvector column vector(1536). Changing model or dim = re-embed everything.
EMBED_DIM=1536
# [core → F05 · B1, F06 · B3, F12 · A1] model.moderate() on what a shop uploads (free)
OPENAI_MODERATION_MODEL=omni-moderation-latest
# [core → F30 voice · B2] model.createRealtimeSession(); rehearsal can use gpt-realtime-2.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# [core → F30 voice · B2] voice of the spoken answer (marin or cedar); cannot change after the first audio reply
OPENAI_REALTIME_VOICE=marin
# [core → F30 voice · B2] live caption of the customer's speech inside the realtime session (languages ['th'])
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# [core → F09 inbox · A1, F17 line · C2, F18 meta · C2] model.transcribe() for voice-message files (stretch)
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# [core] unused and left empty: every TTS model is deprecated (off 6 Jan 2027); spoken answers use Realtime
OPENAI_TTS_MODEL=
# [core] per call timeout in ms (the single retry fits inside it)
MODEL_TIMEOUT_MS=20000
# [core] output cap per call; it INCLUDES reasoning tokens (minimum 16)
MODEL_MAX_OUTPUT_TOKENS=2000
# [F10 ai-agent · B2] 1 = a clear "talk to a human" request hands off (takeover + notify). 0 = bot keeps helping and never promises a human.
ESCALATION_ENABLED=1
# [core → F27 analytics · B3] price table, USD per 1M tokens, Standard tier (docs/openai-api.md §1.1 + realtime §10.1):
#   {"<model id>":{"input":0,"cachedInput":0,"output":0}} · realtime models add "audioInput","audioCachedInput","audioOutput".
#   Cost = (input − cached − cacheWrite) × input + cached × cachedInput + cacheWrite × input × 1.25 + output × output.
#   A model missing here (e.g. the transcribe models, priced per minute) → cost null + costReason 'no_rate' (never 0).
MODEL_PRICE_TABLE={"gpt-6.2-astra":{"input":8,"cachedInput":0.40,"output":40},"gpt-6.2-sol":{"input":2,"cachedInput":0.10,"output":10},"gpt-6.1-terra":{"input":1,"cachedInput":0.05,"output":5},"gpt-6-luna":{"input":0.10,"cachedInput":0.01,"output":0.50},"text-embedding-3-large":{"input":0.13,"cachedInput":0,"output":0},"text-embedding-3-small":{"input":0.02,"cachedInput":0,"output":0},"omni-moderation-latest":{"input":0,"cachedInput":0,"output":0},"gpt-realtime-2.1":{"input":4,"cachedInput":0.40,"output":24,"audioInput":32,"audioCachedInput":0.40,"audioOutput":64},"gpt-realtime-2.1-mini":{"input":0.60,"cachedInput":0.06,"output":2.40,"audioInput":10,"audioCachedInput":0.30,"audioOutput":20}}

# ─────────────────────────────── LINE (F17 line · C2) ───────────────────────────────
# [F17 line · C2] sandbox = core sandbox-capture sender + signed fixtures; real = Messaging API with the test OA below
LINE_MODE=sandbox
# [F17 line · C2] test Official Account (Messaging API channel) — values go in ../nless.secrets.env
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# [F17 line · C2] webhook path registered in the LINE console: ${PUBLIC_BASE_URL}/webhooks/line/<channel id in our DB>

# ─────────────────────────────── Meta: Messenger + Instagram (F18 meta · C2, F21 comments · C2) ───────────────────────────────
# [F18 meta · C2] sandbox | real. real = the team's Meta developer app in Development mode: app roles / test users only,
# no app review or business verification needed, so real sends to those test accounts count as R.
META_MODE=sandbox
META_APP_ID=
META_APP_SECRET=
# [F18 meta · C2, F21 comments · C2] our own random string, typed into the Meta webhook setup (hub.verify_token)
META_VERIFY_TOKEN=REPLACE_RANDOM_VERIFY_TOKEN
# [F18 meta · C2] Graph API version (default v25.0)
META_GRAPH_VERSION=v25.0
# [F18 meta · C2] OAuth redirect = ${PUBLIC_BASE_URL or WEB_ORIGIN}/oauth/callback (state prefix 'meta:')
# [F18 meta · C2] optional fixed test Page / IG professional account for the demo (ids, not tokens)
META_TEST_PAGE_ID=
META_TEST_IG_ACCOUNT_ID=

# ─────────────────────────────── Google: Calendar + Docs/Sheets (F16 calendar · A3, F06 knowledge-import · B3) ───────────────────────────────
# [F16 calendar · A3, F06 knowledge-import · B3] sandbox | real (OAuth client in "Testing" with listed test users).
# Not an AI provider. Google Docs/Sheets import in F06 is stretch.
GOOGLE_MODE=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [F16 · A3, F06 · B3] redirect = ${WEB_ORIGIN}/oauth/callback; state prefixes 'gcal:' (F16) and 'gdocs:' (F06)
# [F16 calendar · A3] test calendar id used in the demo (not a personal calendar)
GOOGLE_TEST_CALENDAR_ID=

# ─────────────────────────────── payments (F14 payments · A2) ───────────────────────────────
# [F14 payments · A2] sandbox (labelled simulator, no real money) for the whole event. No Omise (cut 20 Nov): no payment-provider keys.
PAYMENT_MODE=sandbox
# [F14 payments · A2] slip check: vision | sandbox
#   vision  = read the slip with model:'chat' + image part (detail 'high') into a strict schema, then check in code:
#             amount = order total, receiver = this shop, bankRef unique; unsure or mismatch → staff confirms.
#             Mode S: NOT bank-verified, never claim it is.
#   sandbox = labelled simulator, no model call.
SLIP_VERIFY_MODE=vision
# [F14 payments · A2] PromptPay id used to render demo QR codes. Use a TEST value, never a real bank/phone/tax id.
PROMPTPAY_TEST_ID=REPLACE_TEST_PROMPTPAY_ID

# ─────────────────────────────── web push (F31 notifications · C3) ───────────────────────────────
# [F31 notifications · C3] generate locally: npx web-push generate-vapid-keys. Empty = bell only, push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.test

# ─────────────────────────────── voice (F30 voice · B2) ───────────────────────────────
# [F30 voice · B2] cost guard for the demo tenant (not a customer quota): max seconds per session / per day
VOICE_MAX_SECONDS=120
VOICE_DAILY_SECONDS=900

# ─────────────────────────────── demo / release (F35 core/jobs · C1 ops tools, used by F36 release · C1) ───────────────────────────────
# [F35 · C1] 1 = allow POST /api/v1/ops/demo/reset and `npm run demo:reset` on production (synthetic tenants only, requirePlatformAdmin)
DEMO_RESET_ENABLED=0

# ─────────────────────────────── public Demo Chat (F09 inbox · A1) ───────────────────────────────
# [F09 inbox · A1] cost guard for the PUBLIC web Demo Chat (not a customer quota): max AI turns per day across all visitors; over the cap
# the chat answers with a polite "demo is resting" message and no model call. Per-visitor limits use core rateLimit().
DEMO_CHAT_DAILY_TURN_CAP=300

# ─────────────────────────────── follow-up nudges (F38 follow-ups · B2) ───────────────────────────────
# [F38 follow-ups · B2] no env variables: delay (default 4 h), quiet hours (default 21:00-08:00 in the business timezone),
# channels and the on/off switch are per-business settings stored in the feature's own table (docs/specs/F38-follow-ups.md §2).

# ─────────────────────────────── AI evals (F37 evals · B1) ───────────────────────────────
# [F37 evals · B1] hard stop for one real-model eval run, in USD (the runner stops and reports partial results above it).
# CI always runs the fake model (cost 0).
EVAL_MAX_COST_USD=2.5

# ─────────────────────────────── ChatGPT catalog: ACP feed + MCP server (F39 chatgpt-catalog · C1) ───────────────────────────────
# [F39 chatgpt-catalog · C1] 1 = mount the MCP endpoint (search_catalog, get_price, propose_order). 0 = feed export only.
MCP_ENABLED=1

# ─────────────────────────────── Playwright smoke (tests/e2e · C1; used by every feature's smoke spec) ───────────────────────────────
# [tests/e2e] base URL of the web app under test. lane:init writes http://localhost:<WEB_PORT>; for production put the Render URL
# in ../nless.secrets.env (E2E_BASE_URL=https://<render-url>) so the same specs run against production. Not read by the server.
E2E_BASE_URL=http://localhost:5170
# [tests/e2e] seed owner A, the user behind the `ownerPage` fixture
E2E_EMAIL=owner.a@example.test
# [tests/e2e] password of that user once F02 exists (SEED_USER_PASSWORD of that deployment). Secret: only in ../nless.secrets.env
E2E_PASSWORD=
# [tests/e2e] production DEV_LOGIN_TOKEN, used by the fixture before F02 exists (dev login). Secret: only in ../nless.secrets.env
E2E_DEV_LOGIN_TOKEN=
# [F02 auth · C3] 1 = the Playwright signup smoke may create a throw-away account (never set on production: the test is skipped there)
E2E_ALLOW_SIGNUP=
# [F35 core/jobs + F36 release · C1] platform-admin login for the /ops and /release smokes (dev login with the token is used when empty)
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=
# [F35 core/jobs · C1] feature whose flag the /ops smoke hides and shows again (must be a feature that is not part of the demo)
E2E_FLAG_FEATURE=F12
# [F36 release · C1] when set, the release smoke fails unless /build-info reports this git sha
E2E_EXPECT_SHA=

# ─────────────────────────────── team board (tools/team-board.ps1 — a dev tool; the app ignores these) ───────────────────────────────
# Secrets only in ..\nless.secrets.env: SITES_URL, SITES_BYPASS_TOKEN and BOARD_SECRET never go in git, in this
# file, in .env.local commits, in logs or in a board post. The board script is the single writer: it posts to the
# Sites dashboard AND mirrors every post to the pinned GitHub issue. It reads these keys from the process
# environment, else from ..\nless.secrets.env (not from .env.local); they are listed here so every name is documented.
# [board] base URL of the private ChatGPT Sites dashboard (shared with the 3 team accounts only). Secret: only in ..\nless.secrets.env
SITES_URL=
# [board] SIWC bypass token, sent as header `OAI-Sites-Authorization: Bearer <token>`. Secret: only in ..\nless.secrets.env
SITES_BYPASS_TOKEN=
# [board] the site's own shared secret, sent as `Authorization: Bearer <secret>`. Secret: only in ..\nless.secrets.env
BOARD_SECRET=
# [board] where hooks / wait mode read from: sites (default; any error → falls back to the GitHub issue) | github (force GitHub)
BOARD_SOURCE=sites
# [board] GitHub mirror: owner/repo, pinned issue number, and the comma-separated GitHub logins whose posts count
BOARD_REPO=REPLACE_OWNER_REPO
BOARD_ISSUE=
BOARD_TEAM_LOGINS=

# ─────────────────────────────── browser (Vite, compiled into the bundle — NO SECRETS) ───────────────────────────────
# [core web] API base path (same origin in production)
VITE_API_BASE=/api/v1
# [core web] WebSocket path
VITE_WS_PATH=/ws
# [core web] show the DEV LOGIN picker on /login while F02 auth (C3) is not merged (server still enforces DEV_LOGIN)
VITE_DEV_LOGIN=1
# [F31 notifications · C3] public VAPID key for the browser push subscription (public by design)
VITE_VAPID_PUBLIC_KEY=
